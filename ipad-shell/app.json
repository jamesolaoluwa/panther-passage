{
  "expo": {
    "name": "Panther Passage",
    "slug": "panther-passage-ipad-shell",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "pantherpassage",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "extra": {
      "webUrl": "http://localhost:4174"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#10281f"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "light",
      "infoPlist": {
        "UIRequiresFullScreen": true
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
